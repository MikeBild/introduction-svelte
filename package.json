{
	"name": "introduction-svelte",
	"private": true,
	"version": "2026.10.0",
	"description": "Übungen zu Svelte 5 und SvelteKit 3 am Beispiel Werkstatt-Shop",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:start": "vitest run --mode start",
		"test:start:watch": "vitest --mode start"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#uebungen/*": "./src/uebungen/*"
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26",
		"jsdom": "^30.1.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
